# Optional defaults applied when the wheel is plugged in.
# install.sh copies this file to /etc/udev/rules.d/99-t150-defaults.rules.
# Uncomment and edit, then: udevadm control --reload && udevadm trigger
#
# SUBSYSTEM=="hid", DRIVER=="hid-t150", ATTR{range}="900", ATTR{gain}="49150", ATTR{spring_level}="100", ATTR{damper_level}="100"
